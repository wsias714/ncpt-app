# OAuth *web application* client ID from the tillerautomation Cloud project.
# Public by design (no secret). Authorized JS origins: the Pages origin and http://localhost:5173.
VITE_GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
# NCPT Books Sheet id (not a secret; access is controlled by the signed-in Google account)
VITE_SHEET_ID=REPLACE_WITH_SHEET_ID
